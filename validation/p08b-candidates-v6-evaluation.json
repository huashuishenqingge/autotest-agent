          "content": "def test_contract():\n    from datetime import datetime,timezone,tzinfo\n    from dateutil.tz._common import _validate_fromutc_inputs\n    class Receiver(tzinfo): pass\n    receiver=Receiver()\n    calls=[]\n    @_validate_fromutc_inputs\n    def convert(self,dt):\n        calls.append(dt)\n        return dt\n    error_type=None\n    try: convert(receiver,datetime(2020,1,1,tzinfo=timezone.utc))\n    except Exception as exc: error_type=type(exc)\n    assert error_type is ValueError\n    assert calls==[]\n",
